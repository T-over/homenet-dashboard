# =============================================================
# HomeNet Dashboard — Configuration
# Renommez ce fichier en .env et remplissez les valeurs
# =============================================================

# Plage réseau à scanner (notation CIDR)
NETWORK_RANGE=192.168.1.0/24

# Intervalle entre deux speedtests automatiques (en minutes)
SPEEDTEST_INTERVAL_MIN=60

# Seuil de débit descendant minimum (en Mbps)
ALERT_THRESHOLD_MBPS=50.0

# Chemin vers la base de données SQLite
DATABASE_PATH=homenet.db

# Adresse d'écoute du serveur
HOST=0.0.0.0

# Port du serveur
PORT=8000

# Clé API NIST NVD (optionnel)
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
